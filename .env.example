# --- App ---
APP_URL=https://televet.co
CRON_SECRET=change-me

# --- Supabase (database + auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe Connect (Europe, UK, US, CH, PL, AU) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mercado Pago (AR, UY, CL, MX, BR) — one application per country ---
MP_CLIENT_ID_AR=
MP_CLIENT_SECRET_AR=
MP_CLIENT_ID_UY=
MP_CLIENT_SECRET_UY=
MP_CLIENT_ID_CL=
MP_CLIENT_SECRET_CL=
MP_CLIENT_ID_MX=
MP_CLIENT_SECRET_MX=
MP_CLIENT_ID_BR=
MP_CLIENT_SECRET_BR=

# --- Google Calendar (OAuth app, must pass Google verification) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=            # optional: without it, free OpenStreetMap geocoding (Photon) is used
PHOTON_URL=                     # optional: self-hosted Photon for high traffic

# --- Practice software partners (fill once API access is granted) ---
VETUP_API_BASE=
VETIT_API_BASE=
PETBOOQZ_API_BASE=

# --- Video consultations (Daily) ---
DAILY_API_KEY=
DAILY_GEO=                      # optional, e.g. eu-central-1 to keep calls in Europe
VISIO_LINK_SECRET=              # random string used to sign the e-mail links

# --- AI consultation reports (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Clinic claims (Google Business Profile check + work e-mail code) ---
# uses GOOGLE_MAPS_API_KEY (Places API New enabled)
ADMIN_EMAILS=                   # Televet team members who review document claims

# --- Transactional email ---
RESEND_API_KEY=
EMAIL_FROM=Televet <no-reply@televet.co>

# --- Website chat assistant ---
# uses ANTHROPIC_API_KEY. ADMIN_EMAILS (above) = staff who can read conversations at /admin/chats
CHAT_MODEL=claude-sonnet-5-5   # use claude-haiku-5-5 for lower cost
CHAT_DAILY_LIMIT=3000          # max visitor messages per 24 h, whole site (cost cap)
CHAT_RETENTION_DAYS=90         # conversations older than this are deleted every night
CHAT_HASH_SECRET=              # random string; IPs are stored only as an HMAC for rate limiting

# Public pages
PRO_SIGNUP_URL=   # where "Create my profile" on /pro leads; {lang} and {country} are replaced. Empty = mailto:contact@televet.co
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # Stripe publishable key (pk_...) for the card form on the booking page

# Satisfaction survey: link where 5-star customers are invited to leave a Google review
# (Google Business Profile → "Ask for reviews" → copy the link, e.g. https://g.page/r/XXXX/review)
GOOGLE_REVIEW_URL=
# Inbox for contact form messages and low-rating alerts (defaults to contact@televet.co)
CONTACT_TO=
